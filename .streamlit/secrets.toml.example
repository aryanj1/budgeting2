# Rename this file to .streamlit/secrets.toml for LOCAL use only.
# For Streamlit Community Cloud, paste these lines in App > Settings > Secrets.
# Never upload the filled-in secrets.toml to GitHub.
SUPABASE_URL = "https://YOUR-PROJECT-ID.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_YOUR_REAL_SECRET_KEY"
OWNER_PASSWORD = "REPLACE_WITH_A_LONG_UNIQUE_OWNER_PASSWORD"
VIEWER_PASSWORD = "REPLACE_WITH_A_DIFFERENT_READ_ONLY_PASSWORD"
